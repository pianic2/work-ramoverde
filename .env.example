COMPOSE_PROJECT_NAME=ramoverde
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Host port for the local PostgreSQL container (5440 avoids clashes with other local stacks).
POSTGRES_PORT=5440
# Optional: PostgreSQL data location (named volume by default). Set an absolute host path to
# keep the database on another disk, e.g. POSTGRES_DATA=/home/<you>/.local/share/ramoverde/pgdata
# POSTGRES_DATA=postgres-data
DATABASE_URL=postgresql://app:app@postgres:5432/app
DJANGO_SECRET_KEY=development-only-change-me-before-deploying-please
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5180
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5180
WEB_PORT=5180
API_PORT=8010
API_BASE_URL=http://localhost:8010/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8010/api/v1
S3_ENDPOINT_URL=
S3_STORAGE_ENABLED=false
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Media (docs/architecture/media.md): separate public/private buckets recommended on R2.
S3_PUBLIC_BUCKET_NAME=
S3_PRIVATE_BUCKET_NAME=
S3_PUBLIC_CUSTOM_DOMAIN=
MEDIA_MAX_UPLOAD_SIZE=15728640
MEDIA_MAX_VIDEO_UPLOAD_SIZE=209715200
MEDIA_PRIVATE_URL_TTL=300
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_ENABLED=false
