{
  "name": "ramoverde",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "pnpm --filter @ramoverde/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:schema": "make api-schema",
    "api:client": "make api-client",
    "api:check": "make api-check",
    "check": "make check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ramoverde/eslint-config": "workspace:*",
    "@ramoverde/typescript-config": "workspace:*",
    "eslint": "10.11.0",
    "orval": "8.36.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
