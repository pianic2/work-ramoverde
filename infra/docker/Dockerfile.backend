FROM ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc AS uv-bin
FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0 AS base
COPY --from=uv-bin /uv /uvx /bin/
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
ARG UV_EXTRA_ARGS=""
COPY apps/backend/pyproject.toml apps/backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project $UV_EXTRA_ARGS
COPY apps/backend ./
RUN uv sync --frozen --no-dev --no-install-project $UV_EXTRA_ARGS && useradd --create-home --uid 10001 app && chown -R app:app /app
USER app
EXPOSE 8000
FROM base AS production
ENV DJANGO_SETTINGS_MODULE=config.settings.production
RUN DJANGO_SETTINGS_MODULE=config.settings.development /app/.venv/bin/python manage.py collectstatic --noinput
CMD ["/app/.venv/bin/gunicorn", "config.wsgi:application", "--bind=0.0.0.0:8000", "--workers=3", "--access-logfile=-"]

FROM base AS development
ENV DJANGO_SETTINGS_MODULE=config.settings.development
USER root
RUN uv sync --frozen --all-groups --no-install-project
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
