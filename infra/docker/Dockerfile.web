FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS base
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages
RUN corepack pnpm --filter @ramoverde/web... install --frozen-lockfile
COPY . .

FROM base AS development
EXPOSE 5173
CMD ["corepack", "pnpm", "--filter", "@ramoverde/web", "dev", "--host", "0.0.0.0"]

FROM base AS build
ARG VITE_API_BASE_URL=https://api.example.com/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN corepack pnpm --filter @ramoverde/web build

FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8 AS production
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
